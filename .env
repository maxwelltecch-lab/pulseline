# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Payments (Stripe used as example; swap for Play Billing / App Store IAP / M-Pesa as needed)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Database (this scaffold ships with an in-memory store for local dev —
# swap config/db.js for a real Postgres/Mongo connection before production)
DATABASE_URL=postgres://user:password@localhost:5432/pulseline

# Edge nodes (see docs/DEPLOYMENT.md — each is a real VPS you control,
# running WireGuard + edge-agent/). Set host/publicKey/agentUrl per node
# directly in the server registry (backend/src/config/seed.js) once
# deployed — this env var only holds the per-node agent secrets:
# name=secret,name=secret matching each node's own edge-agent/.env
AGENT_SECRETS=Nairobi=weareallgonnadiesoonletsdiepieceful,Singapore=changeme2,Mumbai=weareallgonnadiesoonletsdiepieceful,Frankfurt=changeme4,Cape Town=changeme5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
